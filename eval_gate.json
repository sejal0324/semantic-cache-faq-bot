  "real": [
    {"file": "reports/results.json", "path": "chosen.false_hits", "op": "<=", "value": 1, "why": "at most one wrong cached answer on 100 questions"},
    {"file": "reports/results.json", "path": "chosen.hit_rate", "op": ">=", "value": 0.5, "why": "recall on repeat questions; raise this after your first real run"},
    {"file": "reports/results.json", "path": "chosen.avg_e2e_ms", "op": "<", "value": "$baseline_avg_ms", "why": "the cache must make answers faster on average"},
    {"file": "reports/results.json", "path": "guard_off_false_hits", "op": ">=", "value": "$chosen.false_hits", "why": "the negation guard must not add false hits"}
