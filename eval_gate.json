{
  "smoke": [
    {"file": "reports/smoke/results.json", "path": "baseline_llm_calls", "op": "==", "value": 100, "why": "every test question measured once without the cache"},
    {"file": "reports/smoke/results.json", "path": "chosen.false_hits", "op": "<=", "value": 1, "why": "threshold picker must respect the false-hit budget"},
    {"file": "reports/smoke/results.json", "path": "chosen.llm_calls", "op": "<=", "value": "$baseline_llm_calls", "why": "the cache never adds LLM calls"},
    {"file": "reports/smoke/results.json", "path": "cost_per_1k_after", "op": "<=", "value": "$cost_per_1k_before", "why": "the cache never adds cost"}
